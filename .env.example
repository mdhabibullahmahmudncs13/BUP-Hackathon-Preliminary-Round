# OpenRouter credentials (required for /interpret; /schedule works without it)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Primary and same-provider fallback models (fallback covers rate limits/outages)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.1-70b-instruct
